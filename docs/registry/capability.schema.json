{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetaAutomate Capability Definition v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "domain", "user_segments", "problem", "outcome", "input_schema", "output_schema", "required_permissions", "verification_policy", "release", "lifecycle_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 3},
    "domain": {"enum": ["Core", "Business", "Personal", "Creative", "Specialized"]},
    "user_segments": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "description": {"type": "string"},
    "problem": {"type": "string"},
    "outcome": {"type": "string"},
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "required_permissions": {"type": "array", "items": {"type": "string"}},
    "connectors": {"type": "array", "items": {"type": "string"}},
    "execution_mode": {"enum": ["ASSIST", "COLLABORATE", "AUTONOMOUS", "CONTINUOUS"]},
    "approval_policy": {"type": "object"},
    "verification_policy": {"type": "object"},
    "recovery_policy": {"type": "object"},
    "value_metrics": {"type": "array", "items": {"type": "string"}},
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "owner": {"type": "string"},
    "lifecycle_status": {"enum": ["DRAFT", "REVIEW", "ACTIVE", "DEPRECATED", "RETIRED"]},
    "release": {"enum": ["R1", "R2", "R3", "R4"]},
    "acceptance_tests": {"type": "array", "items": {"type": "string"}}
  }
}
