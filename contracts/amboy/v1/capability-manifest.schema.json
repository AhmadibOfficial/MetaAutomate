{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amboy Capability Manifest v1 (draft only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "product",
    "version",
    "status",
    "risk",
    "required_scopes",
    "approval_required",
    "input_schema"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(metaautomate|onecall)\\.[a-z][a-z0-9_.]+$"
    },
    "product": {
      "type": "string",
      "enum": [
        "metaautomate",
        "onecall"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "const": "draft"
    },
    "risk": {
      "type": "string",
      "enum": [
        "read_only",
        "propose",
        "mutate_sensitive"
      ]
    },
    "required_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "input_schema": {
      "type": "object"
    },
    "verification_strategy": {
      "type": "string",
      "maxLength": 600
    }
  }
}
