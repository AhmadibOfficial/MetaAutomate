{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amboy Turn Request (proposed, non-operational)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_request_id",
    "message"
  ],
  "properties": {
    "client_request_id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "requested_mode": {
      "type": "string",
      "enum": [
        "answer",
        "prepare_plan",
        "propose_action"
      ]
    },
    "context_hint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface": {
          "type": "string",
          "enum": [
            "metaautomate_workspace",
            "onecall_app"
          ]
        },
        "resource_id": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  },
  "description": "Identity/product/tenant/role/scope derived ONLY from authenticated gateway context; never accepted from request payload."
}
