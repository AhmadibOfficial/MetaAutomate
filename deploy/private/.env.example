# Copy to deploy/private/.env; chmod 600; never commit credentials.
# Use URL-safe hex secrets generated independently, e.g. openssl rand -hex 32.
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX

# Tailscale Serve privately proxies your HTTPS tailnet URL -> localhost:8080.
WORKSPACE_ORIGIN=https://metaautomate-private.example-tailnet.ts.net
OIDC_REDIRECT_URI=https://metaautomate-private.example-tailnet.ts.net/v1/workspace/oidc/callback

# Configure a trusted OIDC identity provider (e.g., Microsoft Entra or Keycloak).
OIDC_ISSUER=https://YOUR_IDENTITY_PROVIDER_ISSUER
OIDC_CLIENT_ID=REPLACE_WITH_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
OIDC_STATE_SECRET=REPLACE_WITH_RANDOM_LONG_SECRET_48PLUS

# VERIFIED OWNER IDENTITY, from your OIDC provider administrator console.
# Must not be guessed from an email address.
META_OWNER_SUBJECT=REPLACE_WITH_VERIFIED_IDP_SUBJECT
META_OWNER_EMAIL=REPLACE_WITH_OWNER_EMAIL
META_ORG_SLUG=metaautomate-internal
