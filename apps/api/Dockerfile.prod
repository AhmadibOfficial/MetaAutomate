# Private OIDC-only application image; requires externally approved private infrastructure.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    WORKSPACE_AUTH_MODE=oidc \
    WORKSPACE_COOKIE_SECURE=1 \
    WORKSPACE_WEB_ROOT=/srv/metaautomate/web
WORKDIR /srv/metaautomate
COPY apps/api/requirements.txt /tmp/api-requirements.txt
RUN pip install --no-cache-dir -r /tmp/api-requirements.txt \
    && groupadd --system --gid 10001 meta \
    && useradd --system --uid 10001 --gid 10001 --home /nonexistent meta
COPY --chown=meta:meta apps/api/app/ /srv/metaautomate/app/
COPY --chown=meta:meta apps/web/ /srv/metaautomate/web/
USER meta
EXPOSE 8000
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","2","--no-access-log"]
